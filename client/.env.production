# Production build env — baked into the /old bundle at `npm run build` time.
# Vite only embeds VITE_* vars present during build; a missing value becomes
# `undefined` in the bundle and all API calls break. Keep this file committed
# so every build (local or CI) targets the right backend.

# Legacy backend on Render (no trailing slash)
VITE_API_URL=https://habtrackit.onrender.com

# --- Firebase web config (needed for Google sign-in, FCM push, Storage) ---
# TODO: fill from Firebase Console → Project settings → Your apps.
# Until set, Google sign-in / push tokens / profile-picture upload stay broken.
#VITE_APIKEY=
#VITE_AUTHDOMAIN=
#VITE_PROJECTID=
#VITE_STORAGEBUCKET=
#VITE_MESSAGINGSENDERID=
#VITE_APPID=
#VITE_MEASUREMENTID=
#VITE_VAPIDKEY=

# --- EmailJS contact form (WriteUs page) ---
# TODO: fill from https://www.emailjs.com dashboard.
#VITE_EMAILJS_PUBLIC_KEY=
#VITE_EMAILJS_SERVICE_ID=
#VITE_EMAILJS_TEMPLATE_ID=
